# .env.example
# ============================================================
# Healthcare Revenue Cycle and TPA Process Analytics Dashboard
# ============================================================
#
# No API keys or external services are required.
# The application uses the local Excel workbook and local scikit-learn model.
#
# This file is provided as a template only.
# No environment variables need to be set to run this application.
#
# ============================================================
# Optional configuration (not required for default operation)
# ============================================================
#
# If you wish to override the default delay threshold, you may set it here.
# The application also exposes this as a sidebar slider.
#
# DELAY_THRESHOLD_DAYS=30
#
# ============================================================
# Deployment notes
# ============================================================
#
# Streamlit Community Cloud:
#   No secrets or environment variables are required.
#   Place TPA DATA.xlsx in the repository before deploying.
#
# Render:
#   No environment variables are required.
#   Set start command to:
#   streamlit run app.py --server.port $PORT --server.address 0.0.0.0
#
# ============================================================
